/* DistroForge — all colours come from the active theme ($primary, $accent, …). */

Screen {
    background: $background;
}

/* ── shared panel look ─────────────────────────────── */
#sysinfo, #categories, #items, #details,
#review-summary, #review-warnings, #plan-tree,
#run-items, #run-summary, #log {
    border: round $panel-lighten-2;
    border-title-color: $primary;
    border-title-style: bold;
    background: $surface;
    padding: 0 1;
}

#sysinfo:focus-within, #categories:focus, #items:focus, #plan-tree:focus, #log:focus {
    border: round $primary;
}

.muted { color: $text-muted; }
.error { color: $error; }
.spacer { width: 1fr; }
.inline-label { padding: 1 1 0 0; }
.section { margin-top: 1; text-style: bold; }

/* ── main screen ───────────────────────────────────── */
#topbar {
    height: 1;
    background: $panel;
    color: $text;
}

#body { height: 1fr; }

#sidebar {
    width: 38;
    min-width: 30;
}

#sysinfo {
    height: auto;
    max-height: 12;
}

#categories {
    height: 1fr;
}

#content { width: 1fr; }

#search {
    margin: 0 0 0 0;
    border: round $panel-lighten-2;
    background: $surface;
}
#search:focus { border: round $accent; }

#items {
    height: 1fr;
}

#details {
    height: 9;
}

DataTable > .datatable--cursor {
    background: $primary 35%;
}

/* ── review screen ─────────────────────────────────── */
#review-title, #run-title {
    height: 1;
    background: $primary;
    color: $background;
    text-style: bold;
    padding: 0 1;
}

#review-body { height: 1fr; }
#review-side { width: 46; }
#review-summary { height: 1fr; }
#review-warnings {
    height: auto;
    max-height: 12;
    border: round $warning;
    border-title-color: $warning;
}
#plan-tree { width: 1fr; }

#review-actions, #run-actions {
    height: 3;
    padding: 0 1;
    background: $panel;
}
#review-actions Button, #run-actions Button { margin-left: 1; width: auto; min-width: 12; }
#review-actions Checkbox { margin-left: 2; background: $panel; border: none; }

/* ── run screen ────────────────────────────────────── */
#progress { padding: 1 1 0 1; height: 2; }
#progress Bar { width: 1fr; }
#run-step { padding: 0 1; color: $text-muted; height: 1; }
#run-body { height: 1fr; }
#run-side { width: 44; }
#run-items { height: 1fr; }
#run-summary {
    height: auto;
    max-height: 16;
    border: round $success;
    border-title-color: $success;
}
#log { width: 1fr; }

/* ── dialogs ───────────────────────────────────────── */
ModalScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 64;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}
.dialog-wide { width: 100; }

.dialog-title {
    text-style: bold;
    color: $primary;
    width: 1fr;
    margin-bottom: 1;
}
.dialog-title.error { color: $error; }
.dialog-body { margin-bottom: 1; }
.dialog-output {
    height: auto;
    max-height: 14;
    border: round $error;
    background: $background;
    padding: 0 1;
    margin-bottom: 1;
}
.dialog-buttons {
    height: auto;
    align-horizontal: right;
}
.dialog-buttons Button { margin-left: 1; }
.dialog-buttons Input { width: 1fr; }

#help Logo { width: 1fr; margin-bottom: 1; }
.help-keys { margin: 0 0 1 0; }

#profiles-body { height: 14; margin: 1 0; }
#profile-list { width: 34; border: round $panel-lighten-2; }
#profile-info { width: 1fr; padding: 0 1; border: round $panel-lighten-2; height: 1fr; }

#settings-grid {
    grid-size: 2;
    grid-columns: 22 1fr;
    grid-rows: auto;
    grid-gutter: 1 2;
    height: auto;
    margin-bottom: 1;
}
#settings-grid Label { padding-top: 1; }
#settings-error { height: auto; }
